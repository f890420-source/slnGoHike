@model IEnumerable<prjGoHike.Models.Mountain>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MountainName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Location)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Altitude)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DifficultyLevel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MountainsPermitRequired)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NationalParkPermitRequired)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventData)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HikeRecords)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MountainEquipmentSuggestions)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PersonalEquipmentLists)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.MountainName)
            </td>
            <td>
                @Html.DisplayFor(model => item.Location)
            </td>
            <td>
                @Html.DisplayFor(model => item.Altitude)
            </td>
            <td>
                @Html.DisplayFor(model => item.DifficultyLevel)
            </td>
            <td>
                @Html.DisplayFor(model => item.MountainsPermitRequired)
            </td>
            <td>
                @Html.DisplayFor(model => item.NationalParkPermitRequired)
            </td>
            <td>
                @Html.DisplayFor(model => item.EventData)
            </td>
            <td>
                @Html.DisplayFor(model => item.HikeRecords)
            </td>
            <td>
                @Html.DisplayFor(model => item.MountainEquipmentSuggestions)
            </td>
            <td>
                @Html.DisplayFor(model => item.PersonalEquipmentLists)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MountainId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MountainId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MountainId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
