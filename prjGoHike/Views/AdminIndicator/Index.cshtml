@model IEnumerable<prjGoHike.ViewModels.CIndicatorsWrap>

@{
    ViewData["Title"] = "指標圖資管理";
}

<style>
    .trail-badge {
        font-size: 1rem;
        font-weight: 1000;
    }

    .table-custom th {
        font-size: 1rem;
    }
</style>

<h1>指標圖資管理</h1>

<p>
    <a asp-action="Create" class="btn-custom btn-custom-outline-primary">新增指標</a>
</p>
<table class="table-custom align-middle">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IndicatorName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IndicatorType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Weight)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IndicatorLevel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IndicatorDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataSource)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (prjGoHike.ViewModels.CIndicatorsWrap item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.IndicatorName)
                </td>
                <td>
                    @Html.DisplayFor(model => item.IndicatorType)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Weight)
                </td>
                <td>
                    @Html.DisplayFor(model => item.IndicatorLevel)
                </td>
                <td>
                    @Html.DisplayFor(model => item.IndicatorDescription)
                </td>
                <td>
                    @Html.DisplayFor(model => item.DataSource)
                </td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge-table success trail-badge">已啟用</span>
                    }
                    else
                    {
                        <span class="badge-table pending trail-badge">未啟用</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IndicatorId" class="table-btn-action" title="編輯">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.IndicatorId" class="table-btn-action delete" title="刪除">
                        <i class="bi bi-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
