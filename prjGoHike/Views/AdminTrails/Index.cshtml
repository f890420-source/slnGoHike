@model IEnumerable<prjGoHike.ViewModels.CTrailWrap>

@{
    ViewData["Title"] = "步道管理";
}

<style>
    .trail-badge {
        font-size: 1.2rem;
    }
</style>

<h2>步道管理</h2>

<div class="d-flex align-items-center gap-3 m-3">
    <a asp-action="Create" class="btn-custom btn-custom-outline-primary">新增步道</a>
    <form class="navbar-search-wrapper" method="post">
        <input name="txtKeyword" type="text" class="navbar-search-input" placeholder="搜尋步道">
        <button type="submit" class="navbar-search-btn" aria-label="Search">
            <i class="bi bi-search"></i>
        </button>
    </form>
</div>

<div class="table-responsive">
    <table class="table-custom align-middle">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.TrailName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Region)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DifficultyLevel)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DistanceKm)
                </th>
                @* <th>
                        @Html.DisplayNameFor(model => model.EstimatedHours)
                    </th> *@
                <th>
                    @Html.DisplayNameFor(model => model.PermitRequired)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.GuideRequired)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.IsPublished)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(model => item.TrailName)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Region)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.DifficultyLevel)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.DistanceKm)
                    </td>
                    @* <td>
                            @Html.DisplayFor(model => item.EstimatedHours)
                        </td> *@
                    <td>
                        @if (item.PermitRequired)
                        {
                            <span class="badge-table success">需要申請</span>
                        }
                        else
                        {
                            <span class="badge-table pending">免申請</span>
                        }
                    </td>

                    <td>
                        @if (item.GuideRequired)
                        {
                            <span class="badge-table success">需要嚮導</span>
                        }
                        else
                        {
                            <span class="badge-table pending">不需嚮導</span>
                        }
                    </td>

                    <td>
                        @if (item.IsPublished)
                        {
                            <span class="badge-table success">已發布</span>
                        }
                        else
                        {
                            <span class="badge-table pending">未發布</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Map" asp-route-id="@item.TrailId" class="table-btn-action" title="查看地圖">
                            <i class="bi bi-map"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.TrailId" class="table-btn-action" title="編輯">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.TrailId" class="table-btn-action delete" title="刪除">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>