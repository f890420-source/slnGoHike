@model prjGoHike.ViewModels.CTrailWrap

@{
    ViewData["Title"] = "刪除確認";
}

<h3>你確定要永久刪掉這筆資料嗎?</h3>
<div>
    @* <h4>@Html.DisplayFor(model => model.TrailName)</h4> *@
    <hr />
    <dl class="row mt-2">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TrailName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TrailName)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Region)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Region)
        </dd>
    </dl>
    <form asp-action="Delete" class="d-flex gap-2 p-2">
        <input type="hidden" asp-for="TrailId" />
        <input type="submit" value="永久刪除" class="btn-custom btn-custom-danger" />
        <a asp-action="Index" class="btn-custom btn-custom-outline-primary">回到選單</a>
    </form>
</div>
