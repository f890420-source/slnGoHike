@model prjGoHike.Models.CTrailWrap

@{
    ViewData["Title"] = "編輯步道資訊";
}

<h3>編輯步道資訊</h3>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="TrailId" />
            <div class="form-group">
                <label asp-for="TrailName" class="control-label"></label>
                <input asp-for="TrailName" class="form-control" />
                <span asp-validation-for="TrailName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Region" class="control-label"></label>
                <input asp-for="Region" class="form-control" />
                <span asp-validation-for="Region" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DifficultyLevel" class="control-label"></label>
                <input asp-for="DifficultyLevel" class="form-control" />
                <span asp-validation-for="DifficultyLevel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DistanceKm" class="control-label"></label>
                <input asp-for="DistanceKm" class="form-control" />
                <span asp-validation-for="DistanceKm" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PermitRequired" class="control-label"></label>
                <input asp-for="PermitRequired" class="form-check-input" />
                <span asp-validation-for="PermitRequired" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="GuideRequired" class="control-label"></label>
                <input asp-for="GuideRequired" class="form-check-input" />
                <span asp-validation-for="GuideRequired" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IsPublished" class="control-label"></label>
                <input asp-for="IsPublished" class="form-check-input" />
                <span asp-validation-for="IsPublished" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RegulationNote" class="control-label"></label>
                <input asp-for="RegulationNote" class="form-control" />
                <span asp-validation-for="RegulationNote" class="text-danger"></span>
            </div>
            <div class="form-group d-flex gap-2 p-2">
                <input type="submit" value="儲存修改" class="btn-custom btn-custom-primary" />
                <a asp-action="Index" class="btn-custom btn-custom-outline-primary">回到列表</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
