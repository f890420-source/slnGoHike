@model IEnumerable<prjGoHike.ViewModels.CRiskIndicatorsWrap>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table-custom align-middle">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IndicatorName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IndicatorType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Weight)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RiskLevel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IndicatorDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ValidFrom)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ValidTo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataSource)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (prjGoHike.ViewModels.CRiskIndicatorsWrap item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.IndicatorName)
                </td>
                <td>
                    @Html.DisplayFor(model => item.IndicatorType)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Weight)
                </td>
                <td>
                    @Html.DisplayFor(model => item.RiskLevel)
                </td>
                <td>
                    @Html.DisplayFor(model => item.IndicatorDescription)
                </td>
                <td>
                    @Html.DisplayFor(model => item.ValidFrom)
                </td>
                <td>
                    @Html.DisplayFor(model => item.ValidTo)
                </td>
                <td>
                    @Html.DisplayFor(model => item.DataSource)
                </td>
                <td>
                    @Html.DisplayFor(model => item.IsActive)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.RiskIndicatorId" class="table-btn-action" title="編輯">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.RiskIndicatorId" class="table-btn-action delete" title="刪除">
                        <i class="bi bi-trash"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
