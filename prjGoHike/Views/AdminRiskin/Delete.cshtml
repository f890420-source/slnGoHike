@model prjGoHike.ViewModels.CRiskIndicatorsWrap

@{
    ViewData["Title"] = "指標刪除";
}

<h3>警告：是否永久刪除指標?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IndicatorName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IndicatorName)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IndicatorType)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IndicatorType)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IndicatorDescription)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IndicatorDescription)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsActive)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsActive)
        </dd>
    </dl>
    <form asp-action="Delete" class="d-flex gap-2 p-2">
        <input type="hidden" asp-for="RiskIndicatorId" />
        <input type="submit" value="永久刪除" class="btn-custom btn-custom-danger" />
        <a asp-action="Index" class="btn-custom btn-custom-outline-primary">回到選單</a>
    </form>
</div>
