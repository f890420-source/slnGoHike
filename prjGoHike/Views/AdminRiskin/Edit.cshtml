@model prjGoHike.ViewModels.CRiskIndicatorsWrap

@{
    ViewData["Title"] = "編輯指標資料";
}

<h3>編輯指標資料</h3>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="RiskIndicatorId" />
            <div class="form-group">
                <label asp-for="IndicatorName" class="control-label"></label>
                <input asp-for="IndicatorName" class="form-control" />
                <span asp-validation-for="IndicatorName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IndicatorType" class="control-label"></label>
                <input asp-for="IndicatorType" class="form-control" />
                <span asp-validation-for="IndicatorType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Weight" class="control-label"></label>
                <input asp-for="Weight" class="form-control" />
                <span asp-validation-for="Weight" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RiskLevel" class="control-label"></label>
                <input asp-for="RiskLevel" class="form-control" />
                <span asp-validation-for="RiskLevel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IndicatorDescription" class="control-label"></label>
                <input asp-for="IndicatorDescription" class="form-control" />
                <span asp-validation-for="IndicatorDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ValidFrom" class="control-label"></label>
                <input asp-for="ValidFrom" class="form-control" />
                <span asp-validation-for="ValidFrom" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ValidTo" class="control-label"></label>
                <input asp-for="ValidTo" class="form-control" />
                <span asp-validation-for="ValidTo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DataSource" class="control-label"></label>
                <input asp-for="DataSource" class="form-control" />
                <span asp-validation-for="DataSource" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IsActive" class="control-label"></label>
                <input asp-for="IsActive" class="form-check-input" />
                <span asp-validation-for="IsActive" class="text-danger"></span>
            </div>
            <div class="form-group d-flex gap-2 p-2">
                <input type="submit" value="儲存修改" class="btn-custom btn-custom-primary" />
                <a asp-action="Index" class="btn-custom btn-custom-outline-primary">回到列表</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
