@section Scripts {
    <script>
        $(function() {

            function updateEvidencePreview(url) {
                var $img = $("#evidencePreview");
                var $noImage = $("#evidenceNoImage");

                if (!url) {
                    $img.hide();
                    $noImage.hide();
                    return;
                }

                $img.attr("src", url).show();
                $noImage.hide();
            }

            $(document).on("input", "#evidenceUrlInput", function() {
                updateEvidencePreview($(this).val());
            });

            $(document).on("error", "#evidencePreview", function() {
                $(this).hide();
                $("#evidenceNoImage").show();
            });

            $(document).on("click", ".Btn-Edit", async function(event) {
                event.preventDefault();
                var id = $(this).data("id");

                try {
                    const response = await $.ajax({
                        url: '@Url.Action("EditEventReport", "EventReport")',
                        type: 'GET',
                        data: { id: id }
                    });

                    if (response.success) {
                        $("#EditModal [name='cEventReportWarp.ReportEventId']").val(response.data.reportEventId);
                        $("#EditModal [name='cEventReportWarp.ReportTitle']").val(response.data.reportTitle);
                        $("#EditModal [name='cEventReportWarp.ReportReason']").val(response.data.reportReason);
                        $("#EditModal [name='cEventReportWarp.EvidenceUrl']").val(response.data.evidenceUrl);
                        updateEvidencePreview(response.data.evidenceUrl);
                        $("#EditModal [name='cEventReportWarp.ReportStatus']").val(response.data.reportStatus);
                        $("#EditModal [name='cEventReportWarp.CreatedAt']").val(response.data.createdAt);
                        
                        
                        var editModalEl = document.getElementById('EditEventReport');
                        var editModal = bootstrap.Modal.getOrCreateInstance(editModalEl);
                        editModal.show();
                    } else {
                        alert("建立失敗：" + response.message);
                    }
                } catch (error) {
                    console.error("傳送失敗：", error);
                    alert("系統發生錯誤，無法取得資料。");
                }
            });

            $("#EditModal").on("submit", async function(event) {
                event.preventDefault();
                var dataform = $(this).serialize();

                try {
                    const response = await $.ajax({
                        url: '@Url.Action("EditEventReport", "EventReport")',
                        type: 'POST',
                        data: dataform
                    });

                    if (response.success) {
                        alert(response.message);
                        var modalElement = document.getElementById('EditEventReport');
                        var modal = bootstrap.Modal.getInstance(modalElement);
                        if (modal) {
                            modal.hide();
                            location.reload();
                        }
                    } else {
                        alert(response.message);
                    }
                } catch (error) {
                    console.error("傳送失敗：", error);
                    alert("系統發生錯誤，無法儲存資料。");
                }
            });

            $(document).on("click", ".Btn-Delete", function(event) {
                var id = $(this).data("id");
                $("#deleteEventReportId").val(id);
            });

            $("#DeleteForm").on("submit", async function(event) {
                event.preventDefault();
                var id = $("#deleteEventReportId").val();

                try {
                    const response = await $.ajax({
                        url: '@Url.Action("DeleteEventReport", "EventReport")',
                        type: "POST",
                        data: { id: id }
                    });

                    if (response.success) {
                        var modalElement = document.getElementById('DeleteEventReport');
                        var modal = bootstrap.Modal.getInstance(modalElement);
                        if (modal) {
                            modal.hide();
                            location.reload();
                        }
                    } else {
                        alert(response.message);
                    }
                } catch (error) {
                    console.error("刪除失敗：", error);
                    alert("系統發生錯誤，無法刪除資料。");
                }
            });
        });
    </script>
}

<div class="modal fade" id="EditEventReport" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">修改資料</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="EditModal" method="post">
                <div class="modal-body">
                    <div class="ErrorMessage">
                    </div>
                    <div>
                        @Html.HiddenFor(n => n.cEventReportWarp.ReportEventId)
                    </div>
                    <div class="col-lg-12 ">
                        @Html.LabelFor(n => n.cEventReportWarp.ReportTitle)
                        @Html.TextBoxFor(n => n.cEventReportWarp.ReportTitle, new { @class = "form-control-custom" })
                        

                    </div>
                    <div class="col-lg-12">
                        @Html.LabelFor(n => n.cEventReportWarp.ReportReason)
                        @Html.TextBoxFor(n => n.cEventReportWarp.ReportReason, new { @class = "form-control-custom" })
                        

                    </div>
                    <div class="col-lg-12 mb-3">
                        <img id="evidencePreview" src="" alt="證據預覽圖" style="max-width: 100%; max-height: 300px; display: none; object-fit: contain;" />
                        <p id="evidenceNoImage" style="display: none; color: gray;">無法載入圖片，請確認網址是否正確</p>
                    </div>
                    <div class="col-lg-12 mb-3">
                        @Html.LabelFor(n => n.cEventReportWarp.ReportStatus)
                        @Html.DropDownListFor(
                            n => n.cEventReportWarp.ReportStatus,
                            new List<SelectListItem>
                            {
                                new SelectListItem { Text = "待處理", Value = "待處理" },
                                new SelectListItem { Text = "需停權", Value = "需停權" },
                                new SelectListItem { Text = "已完成", Value = "已完成" }
                            },
                            new { @class = "form-select-custom" }
                        )
                    </div>
                    <div class="col-lg-12 mb-3">
                        @Html.LabelFor(n => n.cEventReportWarp.CreatedAt)
                        @Html.TextBoxFor(n => n.cEventReportWarp.CreatedAt, new { @class = "form-control-custom", @readonly = "readonly" })
                        @* @Html.ValidationMessageFor(n => n.MountainW.MountainsPermitRequired, "") *@

                    </div>
                </div>
                <div class="modal-footer">
                    <div>
                        <button type="button" class="btn-custom btn-custom-outline-secondary " data-bs-dismiss="modal">取消</button>
                        <button id="SaveEdit" type="submit" class="btn-custom btn-custom-outline-secondary">儲存</button>

                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="DeleteEventReport" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title ps-1">刪除資料</h5>
                </div>
            </div>
            <div class="modal-body">
                <p>確定要刪除嗎?</p>
            </div>
            <div class="modal-footer">
                <div>
                    <button type="button" class="btn-custom btn-custom-light" data-bs-dismiss="modal" aria-label="取消">取消</button>
                </div>
                <form id="DeleteForm" method="post">
                    <input type="hidden" name="id" id="deleteEventReportId" />
                    <div>
                        <button type="submit" class="delete-save btn-custom btn-custom-danger" data-bs-dismiss="modal" aria-label="刪除">刪除</button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

<div class="d-flex flex-column justify-content-between" style="min-height: 900px">
    <table class="table">
        <thead>
            <tr>
                <th>
                    序號
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.cEventReportWarp.ReportTitle)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.cEventReportWarp.ReportReason)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.cEventReportWarp.EvidenceUrl)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.cEventReportWarp.ReportStatus)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.cEventReportWarp.CreatedAt)
                </th>

            </tr>

        </thead>

        <tbody>
            @{
                int count = (Model.PageCount - 1) * 10;
                @foreach (var item in Model.cEventReportsList)
                {
                    count++;
                    <tr>

                        <td>
                            @count
                        </td>
                        <td>
                            @Html.DisplayFor(model => item.ReportTitle)
                        </td>
                        <td>
                            @Html.DisplayFor(model => item.ReportReason)
                        </td>
                        <td>
                            @Html.DisplayFor(model => item.EvidenceUrl)
                        </td>
                        <td>
                            @Html.DisplayFor(model => item.ReportStatus)
                        </td>
                        <td>
                            @Html.DisplayFor(model => item.CreatedAt)
                        </td>
                        <td>
                            <p class="d-flex justify-content-end">
                                <button type="button" data-id="@item.ReportEventId" class="Btn-Edit btn-custom btn-custom-outline-secondary">
                                    修改檢舉資料
                                </button>
                            </p>
                        </td>
                        <td>
                            <p class="d-flex justify-content-end">
                                <button type="button" data-id="@item.ReportEventId" class="Btn-Delete btn-custom btn-custom-outline-secondary"
                                        data-bs-toggle="modal" data-bs-target="#DeleteEventReport">
                                    刪除資料
                                </button>
                            </p>
                        </td>
                    </tr>
                }

            }

        </tbody>
        <tfoot>
        </tfoot>
    </table>

    @{
        int totalPage = (int)Math.Ceiling((double)Model.TotalDataCount / 10);
        <div>
            <div class="my-2 d-flex justify-content-center">
                <div>
                    <ul class="pagination pagination-rounded mb-0">
                        @if (Model.PageCount == 1)
                        {
                            <li class="page-item active disabled">
                                <a class="page-link" href="#"><i class="bi bi-chevron-left"></i></a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item active">
                                <a class="page-link" href="@Url.Action("CreatEventReport", new { page = Model.PageCount - 1 })"><i class="bi bi-chevron-left"></i></a>
                            </li>
                        }

                        @for (int i = 1; i <= totalPage; i++)
                        {
                            if (i == Model.PageCount)
                            {
                                <li class="page-item active">
                                    <a class="page-link" href="@Url.Action("CreatEventReport", new { page = i })">@i</a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item"><a class="page-link" href="@Url.Action("CreatEventReport", new { page = i })">@i</a></li>

                            }

                        }
                        @if (Model.PageCount == totalPage)
                        {
                            <li class="page-item active disabled">
                                <a class="page-link" href="#"><i class="bi bi-chevron-right"></i></a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item active">
                                <a class="page-link" href="@Url.Action("CreatEventReport", new { page = Model.PageCount + 1 })"><i class="bi bi-chevron-right"></i></a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </div>

    }
</div>

