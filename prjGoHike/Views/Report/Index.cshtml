@model IEnumerable<prjGoHike.Models.Report>

@{
    ViewData["Title"] = "檢舉管理";

    // 目前頁數
    int currentPage = ViewBag.CurrentPage ?? 1;

    // 總頁數
    int totalPages = ViewBag.TotalPages ?? 1;

    // 目前選擇的狀態
    string currentStatus = ViewBag.Status?.ToString() ?? "";
}

<div class="container-fluid">

    <!-- 標題 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>檢舉管理</h1>
    </div>

    <!-- 狀態篩選 -->
    <div class="card mb-4">
        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row align-items-end">

                    <div class="col-md-3">

                        <label class="form-label">
                            檢舉狀態
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value=""
                                    selected="@(currentStatus == "")">
                                全部
                            </option>

                            <option value="0"
                                    selected="@(currentStatus == "0")">
                                未處理
                            </option>

                            <option value="1"
                                    selected="@(currentStatus == "1")">
                                處理中
                            </option>

                            <option value="2"
                                    selected="@(currentStatus == "2")">
                                已處理
                            </option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit"
                                class="btn btn-primary">
                            篩選
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>


    <!-- 檢舉資料 -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>
                                文章標題
                            </th>

                            <th>
                                檢舉原因
                            </th>

                            <th>
                                狀態
                            </th>

                            <th>
                                檢舉時間
                            </th>

                            <th>
                                操作
                            </th>

                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.Article?.Title
                                </td>

                                <td>
                                    @item.Reason
                                </td>

                                <td>

                                    @switch (item.Status)
                                    {
                                        case 0:
                                            <span class="badge bg-danger">
                                                未處理
                                            </span>
                                            break;

                                        case 1:
                                            <span class="badge bg-warning text-dark">
                                                處理中
                                            </span>
                                            break;

                                        case 2:
                                            <span class="badge bg-success">
                                                已處理
                                            </span>
                                            break;

                                        default:
                                            <span class="badge bg-secondary">
                                                未知
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @item.CreatedDate
                                </td>
                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@item.ReportId"
                                       class="btn btn-primary btn-sm">
                                        詳細資訊
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <!-- 沒有資料 -->
            @if (!Model.Any())
            {
                <div class="text-center py-4">
                    <p class="text-muted mb-0">
                        目前沒有符合條件的檢舉資料
                    </p>
                </div>
            }


            <!-- 分頁 -->
            @if (totalPages > 1)
            {
                <nav aria-label="檢舉資料分頁">
                    <ul class="pagination justify-content-center mt-4">
                        <!-- 上一頁 -->
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(currentPage - 1)"
                               asp-route-status="@currentStatus">
                                上一頁
                            </a>
                        </li>

                        <!-- 頁碼 -->
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-status="@currentStatus">
                                    @i
                                </a>

                            </li>
                        }
                        <!-- 下一頁 -->
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(currentPage + 1)"
                               asp-route-status="@currentStatus">

                                下一頁

                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>