@model prjGoHike.Models.Report

@{
    ViewData["Title"] = "檢舉處理";
}

<div class="container-fluid">

    <h1 class="mb-4">檢舉處理</h1>

    <!-- 檢舉資訊 -->
    <div class="card mb-4">

        <div class="card-header">
            <h5 class="mb-0">檢舉資訊</h5>
        </div>

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-6">
                    <strong>檢舉編號：</strong>
                    @Model.ReportId
                </div>

                <div class="col-md-6">
                    <strong>檢舉時間：</strong>
                    @Model.CreatedDate
                </div>

            </div>

            <div class="mb-3">
                <strong>檢舉原因：</strong>

                <div class="mt-2">
                    @Model.Reason
                </div>
            </div>

        </div>

    </div>


    <!-- 被檢舉文章 -->
    <div class="card mb-4">

        <div class="card-header">
            <h5 class="mb-0">被檢舉文章</h5>
        </div>

        <div class="card-body">

            <h3>
                @Model.Article?.Title
            </h3>

            <hr />

            <div style="white-space: pre-wrap;">
                @Model.Article?.Content
            </div>

        </div>

    </div>


    <!-- 處理檢舉 -->
    <div class="card mb-4">

        <div class="card-header">
            <h5 class="mb-0">處理檢舉</h5>
        </div>

        <div class="card-body">

            <!-- 處理檢舉的表單 -->
            <form asp-action="ProcessReport" method="post">

                <input type="hidden"
                       name="ReportId"
                       value="@Model.ReportId" />

                <!-- 狀態 -->
                <div class="mb-3">

                    <label class="form-label">
                        處理狀態
                    </label>

                    <select name="Status"
                            class="form-select">

                        <option value="0"
                                selected="@(Model.Status == 0)">
                            未處理
                        </option>

                        <option value="1"
                                selected="@(Model.Status == 1)">
                            處理中
                        </option>

                        <option value="2"
                                selected="@(Model.Status == 2)">
                            已處理
                        </option>

                    </select>

                </div>

                <!-- 文章狀態 -->
                <div class="mb-3">

                    <label class="form-label">
                        文章狀態
                    </label>

                    <select name="ArticleStatus"
                            class="form-select">

                        <option value="1"
                                selected="@(Model.Article?.Status == 1)">
                            正常
                        </option>

                        <option value="0"
                                selected="@(Model.Article?.Status == 0)">
                            隱藏
                        </option>

                        <option value="2"
                                selected="@(Model.Article?.Status == 2)">
                            下架
                        </option>

                        <option value="3"
                                selected="@(Model.Article?.Status == 3)">
                            已審核／禁止再次檢舉
                        </option>

                    </select>

                </div>

                <!-- 管理員回覆 -->
                <div class="mb-3">

                    <label class="form-label">
                        管理員回覆
                    </label>

                    <textarea name="Reply"
                              class="form-control"
                              rows="5"
                              placeholder="請輸入處理結果或回覆">@Model.Reply</textarea>

                </div>


                <!-- 按鈕 -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        送出處理
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        返回列表
                    </a>

                </div>

            </form>


            <!-- 刪除檢舉 -->
            <form asp-action="Delete"
                  asp-route-id="@Model.ReportId"
                  method="post"
                  class="mt-3"
                  onsubmit="return confirm('確定要刪除這筆檢舉資料嗎？');">

                <button type="submit"
                        class="btn btn-danger">
                    刪除檢舉
                </button>

            </form>

        </div>

    </div>

</div>