@model prjGoHike.ViewModels_user.Member.LoginViewModel

@{
    ViewData["Title"] = "會員登入 - GO-HIKE";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <!-- 標題 -->
                    <h2 class="text-center mb-4 fw-bold">
                        <i class="bi bi-box-arrow-in-right"></i> 會員登入
                    </h2>
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    <!-- 錯誤訊息 -->
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-circle"></i> @Model.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- 登入表單 -->
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input type="email" asp-for="Email" class="form-control form-control-lg"
                                   placeholder="example@gmail.com" required>
                            <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-bold"></label>
                            <input type="password" asp-for="Password" class="form-control form-control-lg"
                                   placeholder="輸入您的密碼" required>
                            <span asp-validation-for="Password" class="invalid-feedback d-block"></span>
                        </div>
                        <!-- 記住我 -->
                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input" id="rememberMe">
                            <label class="form-check-label" for="rememberMe">
                                記住我（30 天內免登入）
                            </label>
                        </div>

                        <!-- 登入按鈕 -->
                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold mb-3">
                            <i class="bi bi-box-arrow-in-right"></i> 登入
                        </button>
                    </form>

                    <hr class="my-4">

                                        <!-- 底部連結 -->
                    <div class="text-center">
                        <p class="mb-2">還沒有帳號？</p>
                        <a href="@Url.Action("RegisterIndex", "Login")" class="btn btn-outline-success btn-sm fw-bold">
                            <i class="bi bi-person-plus"></i> 立即註冊
                        </a>
                    </div>

                    <!-- 暫時隱藏忘記密碼（待實作） -->
            @*         <div class="text-center mt-3">
                        <small class="text-muted">
                            <a href="#" class="text-decoration-none" onclick="alert('此功能開發中')">
                                忘記密碼？
                            </a>
                        </small>
                    </div>
                </div>
            </div> *@

            <!-- 測試資料提示（開發階段） -->
@*             <div class="alert alert-info mt-3" role="alert">
