@model prjGoHike.ViewModels_user.Member.RegisterViewModel

@{
    ViewData["Title"] = "會員註冊 - GO-HIKE";
}

<div class="container mt-5" style="max-width: 550px;">
    <div class="card shadow-lg border-0">
        <div class="card-body p-5">
            <!-- 標題 -->
            <h2 class="text-center mb-4 fw-bold text-success">
                <i class="bi bi-person-plus-fill"></i> 會員註冊
            </h2>

            <!-- 錯誤訊息提示 -->
            @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle"></i> @Model.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- 註冊表單 -->
            <form asp-controller="Login" asp-action="RegisterIndex" method="post">
                @Html.AntiForgeryToken()

                <!-- 暱稱 -->
                <div class="mb-3">
                    <label asp-for="Nickname" class="form-label fw-bold">暱稱</label>
                    <input asp-for="Nickname" class="form-control form-control-lg" placeholder="例如：登山客小明" required />
                    <span asp-validation-for="Nickname" class="text-danger small"></span>
                </div>

                <!-- 電子信箱 -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold">電子信箱 (Email)</label>
                    <input asp-for="Email" type="email" class="form-control form-control-lg" placeholder="example@gmail.com" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <!-- 密碼 -->
                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-bold">設定密碼</label>
                    <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="請輸入密碼" required />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
                    <input asp-for="ConfirmPassword" class="form-control form-control-lg" placeholder="請再次輸入密碼" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <!-- 偏好地區（選填） -->
                <div class="mb-3">
                    <label asp-for="RegionPreference" class="form-label fw-bold">地區偏好（選填）</label>
                    <select asp-for="RegionPreference" class="form-select form-select-lg">
                        <option value="">-- 請選擇偏好地區 --</option>
                        <option value="北部">北部</option>
                        <option value="中部">中部</option>
                        <option value="南部">南部</option>
                        <option value="東部">東部</option>
                    </select>
                </div>

                <!-- 偏好難度（選填） -->
                <div class="mb-4">
                    <label asp-for="DifficultyPreference" class="form-label fw-bold">難度偏好（選填）</label>
                    <select asp-for="DifficultyPreference" class="form-select form-select-lg">
                        <option value="">-- 請選擇偏好難度 --</option>
                        <option value="新手">新手</option>
                        <option value="中級">中級</option>
                        <option value="挑戰">挑戰</option>
                    </select>
                </div>

                <!-- 註冊按鈕 -->
                <button type="submit" class="btn btn-success btn-lg w-100 fw-bold mb-3">
                    <i class="bi bi-person-check-fill"></i> 立即註冊
                </button>

                <!-- 返回登入連結 -->
                <div class="text-center">
                    <span class="text-muted">已經有帳號了？</span>
                    <a asp-action="Index" class="text-decoration-none fw-bold">返回登入</a>
                </div>
            </form>
        </div>
    </div>
</div>