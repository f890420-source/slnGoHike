@model IEnumerable<prjGoHike.Models.Trail>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TrailName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Region)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DifficultyLevel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DistanceKm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EstimatedHours)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PermitRequired)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GuideRequired)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RegulationNote)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrailPath)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsPublished)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AlertsTrails)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HikeRecordDetails)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrailFeatures)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrailRiskIndicators)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrailSubscriptions)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TripReports)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.TrailName)
            </td>
            <td>
                @Html.DisplayFor(model => item.Region)
            </td>
            <td>
                @Html.DisplayFor(model => item.DifficultyLevel)
            </td>
            <td>
                @Html.DisplayFor(model => item.DistanceKm)
            </td>
            <td>
                @Html.DisplayFor(model => item.EstimatedHours)
            </td>
            <td>
                @Html.DisplayFor(model => item.PermitRequired)
            </td>
            <td>
                @Html.DisplayFor(model => item.GuideRequired)
            </td>
            <td>
                @Html.DisplayFor(model => item.RegulationNote)
            </td>
            <td>
                @Html.DisplayFor(model => item.TrailPath)
            </td>
            <td>
                @Html.DisplayFor(model => item.IsPublished)
            </td>
            <td>
                @Html.DisplayFor(model => item.AlertsTrails)
            </td>
            <td>
                @Html.DisplayFor(model => item.HikeRecordDetails)
            </td>
            <td>
                @Html.DisplayFor(model => item.TrailFeatures)
            </td>
            <td>
                @Html.DisplayFor(model => item.TrailRiskIndicators)
            </td>
            <td>
                @Html.DisplayFor(model => item.TrailSubscriptions)
            </td>
            <td>
                @Html.DisplayFor(model => item.TripReports)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.TrailId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.TrailId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.TrailId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
