@using System.Security.Claims

<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - GoHike</title>

    <!-- SEO Optimization -->
    <meta name="description" content="@ViewData["Description"]">
    <meta name="author" content="GoHike Team">

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/assets/images/favicon.ico">

    <!-- Local Third-Party Libraries (100% Offline Compatible) -->
    <link rel="stylesheet" href="~/assets/libs/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/libs/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="~/assets/libs/apexcharts/apexcharts.css">
    <link rel="stylesheet" href="~/assets/libs/flatpickr/flatpickr.min.css">

    <!-- Main Design System & Custom Stylesheet -->
    <link rel="stylesheet" href="~/assets/css/main.css">
</head>

<body>

    <!-- ==========================================
         START: Sidebar Component
         ========================================== -->
    <div class="sidebar-wrapper" id="sidebar">
        <!-- Brand Logo / Identity -->
        <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
            <i class="bi bi-asterisk"></i>
            <span>GoHike Admin</span>
        </a>

        <!-- Navigation Menu -->
        <div class="flex-grow-1 overflow-y-auto">
            <!-- Group: Menu -->
            <div class="sidebar-menu-section">
                <div class="sidebar-menu-title">Menu</div>
                <ul class="sidebar-menu-list">
                    <li class="sidebar-menu-item">
                        <a asp-controller="Home" asp-action="Index" class="sidebar-menu-link active" id="menu-overview" title="Overview">
                            <i class="bi bi-grid-fill"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Group: Components -->
            <div class="sidebar-menu-section">
                <div class="sidebar-menu-title">Components</div>
                <ul class="sidebar-menu-list">
                    <li class="sidebar-menu-item">
                        <a href="#" class="sidebar-menu-link" id="menu-basictables" title="Basic Tables">
                            <i class="bi bi-table"></i>
                            <span>Basic Tables</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a href="#" class="sidebar-menu-link" id="menu-uiforms" title="Forms and Input">
                            <i class="bi bi-input-cursor-text"></i>
                            <span>Forms & Input</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a href="#" class="sidebar-menu-link" id="menu-uibuttons" title="Buttons">
                            <i class="bi bi-menu-button-wide-fill"></i>
                            <span>Buttons & Alerts</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Group: Pages -->
            <div class="sidebar-menu-section">
                <div class="sidebar-menu-title">Pages</div>
                <ul class="sidebar-menu-list">
                    <li class="sidebar-menu-item">
                        <a href="#" class="sidebar-menu-link" id="menu-blankpage" title="Blank Page">
                            <i class="bi bi-file-earmark"></i>
                            <span>Blank Page</span>
                        </a>
                    </li>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="sidebar-menu-item">
                            <a asp-controller="MemberAdmin" asp-action="Index" class="sidebar-menu-link" title="會員管理">
                                <i class="bi bi-people-fill"></i>
                                <span>會員管理</span>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="sidebar-menu-item">
                            <a asp-controller="Login" asp-action="Index" class="sidebar-menu-link" id="menu-loginpage" title="Login Page">
                                <i class="bi bi-box-arrow-in-right"></i>
                                <span>會員登入</span>
                            </a>
                        </li>
                        <li class="sidebar-menu-item">
                            <a asp-controller="Login" asp-action="RegisterIndex" class="sidebar-menu-link" title="Register Page">
                                <i class="bi bi-person-plus"></i>
                                <span>會員註冊</span>
                            </a>
                        </li>
                    }

                    <li class="sidebar-menu-item">
                        <a asp-controller="Report" asp-action="Index" class="sidebar-menu-link " id="menu-overview" title="Overview">
                            <i class="bi bi-slash-circle"></i>
                            <span>檢舉管理</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a asp-controller="Announcement" asp-action="Index" class="sidebar-menu-link " id="menu-overview" title="Overview">
                            <i class="bi bi-slash-circle"></i>
                            <span>公告管理</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a asp-controller="PersonalEquipment" asp-action="Create" class="sidebar-menu-link" id="menu-personal-equipment" title="裝備配重管理">
                            <i class="bi bi-box-seam"></i>
                            <span>裝備配重管理</span>
                        </a>
                    </li>
                </ul>
            </div>
            <!-- Group: Pages -->
            <div class="sidebar-menu-section">
                <div class="sidebar-menu-title">山況回報</div>
                <ul class="sidebar-menu-list">
                    <li class="sidebar-menu-item">
                        <a asp-controller="AdminTrails" asp-action="Index" class="sidebar-menu-link" id="menu-overview" title="Overview">
                            <i class="bi bi-slash-circle"></i>
                            <span>步道管理</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a asp-controller="AdminRiskin" asp-action="Index" class="sidebar-menu-link" id="menu-overview" title="Overview">
                            <i class="bi bi-slash-circle"></i>
                            <span>指標管理</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a asp-controller="AdminDisAlert" asp-action="Index" class="sidebar-menu-link" id="menu-overview" title="Overview">
                            <i class="bi bi-slash-circle"></i>
                            <span>災害示警管理</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Sidebar Profile Card (Dynamic Footer) -->
        <div class="sidebar-profile">
            <img src="~/assets/images/avatar.png" alt="Profile Image" class="sidebar-profile-img"
                 onerror="this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=256&auto=format&fit=crop'">
            <div class="sidebar-profile-info">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="sidebar-profile-name">@User.Identity.Name</div>
                    <div class="sidebar-profile-email">@(User.FindFirst(ClaimTypes.Email)?.Value ?? "")</div>
                }
                else
                {
                    <div class="sidebar-profile-name">訪客</div>
                    <div class="sidebar-profile-email">未登入</div>
                }
            </div>
        </div>
    </div>
    <!-- ==========================================
         END: Sidebar Component
         ========================================== -->

    <!-- ==========================================
         START: Main Content Area
         ========================================== -->
    <div class="main-wrapper">
       
        <!-- START: Top Navbar Component -->
        <header class="navbar-custom">
            <div class="navbar-left">
                <button class="btn-desktop-toggle d-none d-xl-flex align-items-center justify-content-center me-3"
                        id="desktop-sidebar-toggle" aria-label="Minimize Sidebar">
                    <i class="bi bi-chevron-bar-left"></i>
                </button>
                <button class="sidebar-toggle-btn me-2" id="sidebar-toggle" aria-label="Toggle Navigation">
                    <i class="bi bi-list"></i>
                </button>

                <!-- Quick Actions Dropdown -->
                <div class="dropdown ms-2">
                    <button class="btn-quick-action dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                            id="quick-actions-dropdown">
                        <i class="bi bi-plus-lg"></i>
                        <span>建立</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-quick-action" aria-labelledby="quick-actions-dropdown">
                        <li class="dropdown-header">Quick Action Shortcuts</li>
                            @Html.ActionLink("建立新的山岳", "CreatMountainData","Mountain", new { @class = "bi bi-person-plus" }, new { @class = "dropdown-item" })
                            @Html.ActionLink("管理活動", "ManageEventData", "EventData", new { @class = "bi bi-box-seam" }, new { @class = "dropdown-item" })
                        @* <li><input type="submit" class="dropdown-item" href="#"><i class="bi bi-file-earmark-plus"></i> New Invoice</li> *@
                            @* <li><input type="submit" class="dropdown-item" href="~/Mountain/CreatMountainData"><i class="bi bi-person-plus"></i>建立新的山岳資料</li>
                            <li><input type="submit" class="dropdown-item" href="~/Mountain/MangeEventData"><i class="bi bi-box-seam"></i> 管理活動</li> *@

                        
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li><a class="dropdown-item" href="#"><i class="bi bi-gear"></i> System Settings</a></li>
                    </ul>
                </div>
            </div>

            <!-- Mid navbar: search pill -->
            <div class="navbar-search-wrapper">
                <input type="text" class="navbar-search-input" placeholder="Search anything..." id="main-search">
                <button class="navbar-search-btn" aria-label="Search">
                    <i class="bi bi-search"></i>
                </button>
            </div>

            <!-- Right actions -->
            <div class="navbar-actions">
                <!-- Fullscreen Toggle -->
                <button class="navbar-action-btn me-1" aria-label="Toggle Fullscreen" id="btn-fullscreen">
                    <i class="bi bi-arrows-fullscreen"></i>
                </button>
                
                <!-- Notification Dropdown -->
                <div class="dropdown">
                    <button class="navbar-action-btn dropdown-toggle" type="button" data-bs-toggle="dropdown"
                            aria-expanded="false" id="btn-notifications" data-bs-auto-close="outside">
                        <i class="bi bi-bell"></i>
                        <span class="navbar-action-badge"></span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end dropdown-menu-notification p-0"
                         aria-labelledby="btn-notifications">
                        <div class="notification-header">
                            <h6 class="notification-title">Notifications</h6>
                            <button class="btn-clear-all" type="button">Mark all read</button>
                        </div>
                        <div class="notification-list">
                            <a href="#" class="notification-item">
                                <div class="notification-icon bg-success text-white">
                                    <i class="bi bi-wallet2"></i>
                                </div>
                                <div class="notification-content">
                                    <p class="notification-text">New sale received: <strong>$150.00</strong></p>
                                    <span class="notification-time">2 mins ago</span>
                                </div>
                            </a>
                        </div>
                        <a href="#" class="notification-footer">View All Notifications</a>
                    </div>
                </div>

                <!-- Dynamic Profile Dropdown -->
                <div class="dropdown ms-2">
                    <button class="navbar-profile-btn dropdown-toggle" type="button" data-bs-toggle="dropdown"
                            aria-expanded="false" id="profile-dropdown">
                        <img src="~/assets/images/avatar.png" alt="Profile Image" class="navbar-profile-img">
                        <span class="navbar-profile-name d-none d-md-inline">
                            @(User.Identity != null && User.Identity.IsAuthenticated ? User.Identity.Name : "訪客")
                        </span>
                        <i class="bi bi-chevron-down navbar-profile-caret"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-profile" aria-labelledby="profile-dropdown">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="dropdown-header">你好，@User.Identity.Name！</li>
                            <li>
                                <a class="dropdown-item" asp-controller="Member" asp-action="Dashboard">
                                    <i class="bi bi-person me-2"></i> 會員總覽
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="MemberAdmin" asp-action="Index">
                                    <i class="bi bi-person me-2"></i> 會員管理
                                </a>
                            </li>
                            <li><a class="dropdown-item" asp-controller="Member" asp-action="Profile" >
                                <i class="bi bi-gear me-2"></i> 資料更新</a></li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li>
                                <a class="dropdown-item text-danger" asp-controller="Login" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i> 登出
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="dropdown-header">歡迎造訪！</li>
                            <li>
                                <a class="dropdown-item text-primary" asp-controller="Login" asp-action="Index">
                                    <i class="bi bi-box-arrow-in-right me-2"></i> 會員登入
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item text-success" asp-controller="Login" asp-action="RegisterIndex">
                                    <i class="bi bi-person-plus me-2"></i> 會員註冊
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </header>
        <!-- END: Top Navbar Component -->

        @RenderBody()

        <!-- START: Footer Component -->
        <footer class="footer-custom">
            <div class="footer-left">
                <span class="footer-logo">
                    <i class="bi bi-asterisk"></i> GoHike Admin
                </span>
                <span class="footer-separator">|</span>
                <span class="footer-copy">
                    &copy; 2026 Made with <i class="bi bi-heartbreak-fill text-danger footer-heart"></i> by GoHike Admin
                </span>
            </div>
            <div class="footer-right">
                <ul class="footer-links">
                    <li><a href="#" class="footer-link">Overview</a></li>
                    <li><a href="#" class="footer-link">Help & Documentation</a></li>
                </ul>
            </div>
        </footer>
        <!-- END: Footer Component -->

    </div>
    <!-- ==========================================
         END: Main Content Area
         ========================================== -->

    <!-- Local Third-Party Libraries Script dependencies -->
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/apexcharts/apexcharts.min.js"></script>
    <script src="~/assets/libs/flatpickr/flatpickr.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/assets/js/dashboard.js"></script>
</body>

</html>
