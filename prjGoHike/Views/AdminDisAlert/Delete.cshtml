@model prjGoHike.ViewModels.CDisasterAlertWrap

@{
    ViewData["Title"] = "警示刪除";
}

<h3>確定要永久刪除這個警示資訊嗎</h3>
<div>
    <h4>(請先考慮「取消啟用」功能)</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AlertType)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AlertType)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AlertTitle)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AlertTitle)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AlertDescription)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AlertDescription)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SeverityLevel)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SeverityLevel)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SourceAgency)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SourceAgency)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsActive)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsActive)
        </dd>
    </dl>
    <form asp-action="Delete" class="d-flex gap-2 p-2">
        <input type="hidden" asp-for="AlertId" />
        <input type="submit" value="永久刪除" class="btn-custom btn-custom-danger" />
        <a asp-action="Index" class="btn-custom btn-custom-outline-primary">回到選單</a>
    </form>
</div>
