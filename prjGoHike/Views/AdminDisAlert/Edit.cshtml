@model prjGoHike.ViewModels.CDisasterAlertWrap

@{
    ViewData["Title"] = "警示編輯";
}

<h3>編輯警示</h3>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="AlertId" />
            <div class="form-group">
                <label asp-for="AlertType" class="control-label"></label>
                <input asp-for="AlertType" class="form-control" />
                <span asp-validation-for="AlertType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AlertTitle" class="control-label"></label>
                <input asp-for="AlertTitle" class="form-control" />
                <span asp-validation-for="AlertTitle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AlertDescription" class="control-label"></label>
                <input asp-for="AlertDescription" class="form-control" />
                <span asp-validation-for="AlertDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SeverityLevel" class="control-label"></label>
                <input asp-for="SeverityLevel" class="form-control" />
                <span asp-validation-for="SeverityLevel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EffectiveFrom" class="control-label"></label>
                <input asp-for="EffectiveFrom" class="form-control" />
                <span asp-validation-for="EffectiveFrom" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EffectiveTo" class="control-label"></label>
                <input asp-for="EffectiveTo" class="form-control" />
                <span asp-validation-for="EffectiveTo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SourceAgency" class="control-label"></label>
                <input asp-for="SourceAgency" class="form-control" />
                <span asp-validation-for="SourceAgency" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SourceUrl" class="control-label"></label>
                <input asp-for="SourceUrl" class="form-control" />
                <span asp-validation-for="SourceUrl" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IsActive" class="control-label"></label>
                <input asp-for="IsActive" class="form-check-input" />
                <span asp-validation-for="IsActive" class="text-danger"></span>
            </div>
            <div class="form-group d-flex gap-2 p-2">
                <input type="submit" value="儲存修改" class="btn-custom btn-custom-primary" />
                <a asp-action="Index" class="btn-custom btn-custom-outline-primary">回到列表</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
