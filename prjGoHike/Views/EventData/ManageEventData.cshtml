@model IEnumerable<prjGoHike.Models.CEventDataWarp>

@{
    ViewData["Title"] = "管理活動";
}

<h1>管理活動</h1>

@* <div class="Eventaccordion" id="EventAccordion"> *@
    @{
        int count = 0;
    }
    @foreach (var item in Model)
    {
        count++;
        <div class="accordion">
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapse@(count)" aria-expanded="false" aria-controls="collapse@(count)">
                    @item.EventName　
                    <span class="badge bg-secondary ms-2">@item.ActivityStatus</span>

                </button>
            </h2>
            <div id="collapse@(count)" class="accordion-collapse collapse show" data-bs-parent="#EventAccordion">
                <div class="accordion-body">
                    <dl class="row">
                        <dt class="col-sm-3">@Html.DisplayNameFor(model => item.MountainId)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(modelItem => item.MountainId)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => item.EventName)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(modelItem => item.EventName)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => item.MaximumNumber)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(modelItem => item.MaximumNumber)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => item.ActivityStatus)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(modelItem => item.ActivityStatus)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => item.ActivityPhoto)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(modelItem => item.ActivityPhoto)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => item.Description)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(modelItem => item.Description)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => item.EventDate)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(modelItem => item.EventDate)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => item.ReviewRequired)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(modelItem => item.ReviewRequired)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => item.ReviewStatus)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(modelItem => item.ReviewStatus)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => item.HasActiveReport)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(modelItem => item.HasActiveReport)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => item.LeaderUserId)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(modelItem => item.LeaderUserId)</dd>
                    </dl>

                    <button type="button" id="Edit" data-id="@item.EventId" data-bs-toggle="modal" data-bs-target="">編輯</button>
                    <button type="button" id="Delete" data-id="@item.EventId" data-bs-toggle="modal" data-bs-target="">編輯</button>
                    @* <a asp-action="Edit" id = "Edit" data-id = "@item.EventId">Edit</a>
                    <a asp-action="Delete" id="Delete" data-id = "@item.EventId">Delete</a> *@
                </div>
            </div>
        </div>
    </div>
    }
<div class="modal fade" id="CreateNewEvent" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div <div class="modal-header">>
                <h5 class="modal-title">修改資料</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>

                </div>
                <form id="EditModal" method="post">
                    <div class="modal-body">
                        <div>

                        </div>

                    </div>

                </form>



            </div>
        </div>
    </div>
@section Scripts{
    <script>
        
        $(document).on("click", "Edit", function() {
            var id = $(this).data("id");

            
        })
    </script>

}
