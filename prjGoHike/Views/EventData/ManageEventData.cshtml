        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">修改資料</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>

            </div>
            <form id="EditModal" method="post">
                <div class="modal-body">
                    <div>

                        @Html.LabelFor(e => e.cEvent.EventId)
                        @Html.TextBoxFor(e => e.cEvent.EventId, new { @class = "form-control-custom", @readonly = "readonly" })
                    </div>
                    <div>
                        @Html.LabelFor(e => e.cEvent.MountainId)
                        @Html.TextBoxFor(e => e.cEvent.MountainId, new { @class = "form-control-custom" })
                    </div>
                    <div>
                        @Html.LabelFor(e => e.cEvent.MountainName)
                        @Html.TextBoxFor(e => e.cEvent.MountainName, new { @class = "form-control-custom" })
                    </div>
                    <div>
                        @Html.LabelFor(e => e.cEvent.DifficultyLevel)
                        @Html.TextBoxFor(e => e.cEvent.DifficultyLevel, new { @class = "form-control-custom" })
                    </div>
                    <div>
                        @Html.LabelFor(e => e.cEvent.EventName)
                        @Html.TextBoxFor(e => e.cEvent.EventName, new { @class = "form-control-custom" })
                    </div>
                    <div>
                        @Html.LabelFor(e => e.cEvent.MaximumNumber)
                        @Html.TextBoxFor(e => e.cEvent.MaximumNumber, new { @class = "form-control-custom" })
                    </div>
                    <div>
                        @Html.LabelFor(e => e.cEvent.EventStartTime)
                        @Html.TextBoxFor(e => e.cEvent.EventStartTime, new { @class = "form-control-custom" })
                    </div>
                    <div>
                        @Html.LabelFor(e => e.cEvent.EventEndTime)
                        @Html.TextBoxFor(e => e.cEvent.EventEndTime, new { @class = "form-control-custom" })
                    </div>
                    <div>
                        @Html.LabelFor(e => e.cEvent.ActivityStatus)
                        @Html.TextBoxFor(e => e.cEvent.ActivityStatus, new { @class = "form-control-custom" })
                    </div>
                    <div>
                        @Html.LabelFor(e => e.cEvent.ActivityPhoto)
                        @Html.TextBoxFor(e => e.cEvent.ActivityPhoto, new { @class = "form-control-custom" })
                    </div>
                    <div>
                        @Html.LabelFor(e => e.cEvent.Description)
                        @Html.TextBoxFor(e => e.cEvent.Description, new { @class = "form-control-custom" })
                    </div>
                    @* <div>
                        @Html.LabelFor(e => e.cEvent.EventDate)
                        @Html.TextBoxFor(e => e.cEvent.EventDate, new { @class = "form-control-custom" })
                    </div>
                    <div class="my-3">
                        @Html.LabelFor(e => e.cEvent.ReviewRequired)
                        @Html.CheckBoxFor(e => e.cEvent.ReviewRequired, new { @class = "form-check-input-custom" })
                    </div> *@
                    <div class="my-3">
                        @Html.LabelFor(e => e.cEvent.MountainsPermitRequired)
                        @Html.CheckBoxFor(e => e.cEvent.MountainsPermitRequired, new { @class = "form-check-input-custom" })
                    </div>
                    <div class="my-3">
                        @Html.LabelFor(e => e.cEvent.NationalParkPermitRequired)
                        @Html.CheckBoxFor(e => e.cEvent.NationalParkPermitRequired, new { @class = "form-check-input-custom" })
                    </div>
                    @* <div>
                        @Html.LabelFor(e => e.cEvent.ReviewStatus)
                        @Html.TextBoxFor(e => e.cEvent.ReviewStatus, new { @class = "form-control-custom" })
                    </div> *@
                    <div class="my-3">
                        @Html.LabelFor(e => e.cEvent.HasActiveReport)
                        @Html.CheckBoxFor(e => e.cEvent.HasActiveReport, new { @class = "form-check-input-custom" })
                    </div>
                    <div>
                        @Html.LabelFor(e => e.cEvent.LeaderUserId)
                        @Html.TextBoxFor(e => e.cEvent.LeaderUserId, new { @class = "form-control-custom" })
                    </div>
                </div>
                <div class="modal-footer">
                    <div>
                        <button type="button" class="btn-custom btn-custom-outline-secondary" data-bs-dismiss="modal">取消</button>
                        <button id="SaveEdit" type="submit" class="btn-custom btn-custom-outline-secondary">修改</button>

                    </div>
                </div>
            </form>

        </div>
    </div>
</div>
<div class="modal fade" id="DeleteEvent" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title ps-1">刪除資料</h5>
                </div>
            </div>
            <div class="modal-body">
                <p>確定要刪除嗎?</p>
            </div>
            <div class="modal-footer">
                <div>
                    <button type="button" class="btn-custom btn-custom-light" data-bs-dismiss="modal" aria-label="取消">取消</button>
                </div>
                <form id="DeleteForm" method="post">
                    <input type="hidden" name="id" id="deleteEventId" />
                    <div>
                        <button type="submit" class="delete-save btn-custom btn-custom-danger" data-bs-dismiss="modal" aria-label="刪除">刪除</button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

        
@section Scripts {
    <script>

        $(document).on("click", ".Edit", function() {
            var id = $(this).data("id");

            $.ajax({
                url: '@Url.Action("EditManageEvent", "EventData")',
                type: 'GET',
                data: { id: id },
                success: function(response) {
                    if (response.success) {
                        $("#EditModal [name = 'cEvent.EventId']").val(response.data.eventId);
                        $("#EditModal [name = 'cEvent.MountainId']").val(response.data.mountainId);
                        $("#EditModal [name = 'cEvent.MountainName']").val(response.data.mountainName);
                        $("#EditModal [name = 'cEvent.DifficultyLevel']").val(response.data.difficultyLevel);
                        $("#EditModal [name = 'cEvent.EventName']").val(response.data.eventName);
                        $("#EditModal [name = 'cEvent.MaximumNumber']").val(response.data.maximumNumber);
                        $("#EditModal [name = 'cEvent.EventStartTime']").val(response.data.eventStartTime);
                        $("#EditModal [name = 'cEvent.EventEndTime']").val(response.data.eventEndTime);
                        $("#EditModal [name = 'cEvent.ActivityStatus']").val(response.data.activityStatus);
                        $("#EditModal [name = 'cEvent.ActivityPhoto']").val(response.data.activityPhoto);
                        $("#EditModal [name = 'cEvent.Description']").val(response.data.description);

                        $("#EditModal input[name='cEvent.MountainsPermitRequired'][type='checkbox']").prop("checked", response.data.mountainsPermitRequired);
                        $("#EditModal input[name='cEvent.NationalParkPermitRequired'][type='checkbox']").prop("checked", response.data.nationalParkPermitRequired);

                        //$("#EditModal [name = 'cEvent.EventDate']").val(response.data.eventDate);
                        //$("#EditModal [name = 'cEvent.ReviewStatus']").val(response.data.reviewStatus);
                        // $("#EditModal [name = 'cEvent.LeaderUserId']").val(response.data.leaderUserId);

                        // $("#EditModal input[name='cEvent.ReviewRequired'][type='checkbox']").prop("checked", response.data.reviewRequired);
                        $("#EditModal input[name='cEvent.HasActiveReport'][type='checkbox']").prop("checked", response.data.hasActiveReport);

                        //$("#EditModal [name = 'cEvent.ReviewStatus']").val(response.data.reviewStatus);
                        $("#EditModal [name = 'cEvent.LeaderUserId']").val(response.data.leaderUserId);

                        var editModalEl = document.getElementById('EditManageEvent');
                        var editModal = bootstrap.Modal.getOrCreateInstance(editModalEl);
                        editModal.show();
                    }
                    else {
                        alert("建立失敗：" + response.message);
                    }
                }
            });
        });
        $("#EditModal").on("submit", function(event) {

            event.preventDefault();
            var dataform = $(this).serialize();
            $.ajax({
                url: '@Url.Action("EditManageEvent", "EventData")',
                type: "POST",
                data: dataform,
                success: function(response) {
                    if (response.success) {
                        alert(response.message);
                        var modalElement = document.getElementById('EditManageEvent');
                        var modal = bootstrap.Modal.getInstance(modalElement);
                        if (modal) {
                            modal.hide();
                            location.reload();
                        }
                    }
                    else {
                        alert(response.message)
                    }
                }
            })
        });
        $(document).on("click", ".Delete",function(){
            
            var id = $(this).data("id");
            $("#deleteEventId").val(id);

        });
        $("#DeleteForm").on("submit",function(event){

            event.preventDefault();

            var id = $("#deleteEventId").val();
            $.ajax({

                url: '@Url.Action("DeleteEvent", "EventData")',
                type: 'POST',
                data: { id: id },
                success: function(response) {
                    if (response.success) {
                        var modalElement = document.getElementById('DeleteEvent');
                        var modal = bootstrap.Modal.getInstance(modalElement);
                        if (modal) {
                            modal.hide();
                            location.reload();
                        }
                    }
                }

            })

         });

    </script>

}
@* </div> *@
