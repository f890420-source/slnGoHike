@model prjGoHike.ViewModels.CPersonalEquipmentListDetailsViewModel

@{
    Layout = null;
    ViewData["Title"] = "裝備清單詳細內容";
}

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
            body {
                background-color: #f4f7f5;
            }

            .page-container {
                max-width: 1100px;
            }

            .step-label {
                color: #198754;
                font-size: 0.85rem;
                font-weight: 600;
            }

            .content-card {
                border: 0;
                border-radius: 14px;
            }

            .summary-value {
                font-size: 1.6rem;
                font-weight: 700;
            }

            .table > :not(caption) > * > * {
                padding: 1rem 0.75rem;
                vertical-align: middle;
            }
    </style>
</head>

<body>
    <div class="container page-container py-5">

        <div class="d-flex justify-content-between
            align-items-start mb-4">

            <div>
                <div class="step-label">
                    STEP 05
                </div>

                <h2 class="mb-2">
                    @Model.ListName
                </h2>

                <p class="text-muted mb-0">
                    裝備清單詳細內容
                </p>
            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                返回清單記錄
            </a>
        </div>

        <div class="alert alert-info mb-4">
            <strong>@Model.MountainName</strong>
            ／ @Model.HikingDate.ToString("yyyy/MM/dd")
            ／ @Model.HikingDays 天
            ／ @Model.Season
            ／ @Model.IntensityLevel
            ／ @Model.ExperienceLevel
        </div>

        <div class="row g-3 mb-4">

            <div class="col-md-3">
                <div class="card content-card shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted mb-2">
                            裝備總重量
                        </div>

                        <div class="summary-value">
                            @Model.TotalWeightKg.ToString("0.00") kg
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card content-card shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted mb-2">
                            安全負重上限
                        </div>

                        <div class="summary-value">
                            @Model.MaxCarryWeightKg.ToString("0.00") kg
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card content-card shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted mb-2">
                            剩餘可負重
                        </div>

                        <div class="summary-value">
                            @Model.RemainingWeightKg.ToString("0.00") kg
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="
                    card
                    content-card
                    shadow-sm
                    h-100
                    border
                    border-@Model.StatusBootstrapClass">

                    <div class="card-body">
                        <div class="text-muted mb-2">
                            負重狀態
                        </div>

                        <div class="
                            summary-value
                            text-@Model.StatusBootstrapClass">
                            @Model.WeightStatus
                        </div>

                        <div class="small text-muted mt-2">
                            占體重
                            @Model.WeightPercentage.ToString("0.00")%
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="card content-card shadow-sm mb-4">
            <div class="card-body p-4">

                <h5 class="mb-3">
                    清單資訊
                </h5>

                <div class="row g-3">

                    <div class="col-md-4">
                        <div class="text-muted small">
                            個人體重
                        </div>

                        <div>
                            @Model.BodyWeightKg.ToString("0.00") kg
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-muted small">
                            裝備項目
                        </div>

                        <div>
                            @Model.Items.Count 項
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="text-muted small">
                            建立時間
                        </div>

                        <div>
                            @Model.CreatedAt.ToString(
                                "yyyy/MM/dd HH:mm")
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="card content-card shadow-sm">
            <div class="card-body p-0">

                <div class="p-4 pb-2">
                    <h5 class="mb-0">
                        裝備明細
                    </h5>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>分類</th>
                                <th>裝備名稱</th>
                                <th>程度</th>
                                <th>數量</th>
                                <th>單件重量</th>
                                <th>小計</th>
                                <th>備註</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item
                                in Model.Items)
                            {
                                <tr>
                                    <td>
                                        @item.CategoryName

                                        @if (item.IsCustomEquipment)
                                        {
                                            <span class="
                                                badge
                                                text-bg-secondary
                                                ms-1">
                                                自訂
                                            </span>
                                        }
                                    </td>

                                    <td class="fw-semibold">
                                        @item.EquipmentName
                                    </td>

                                    <td>
                                        @item.RequirementLevel
                                    </td>

                                    <td>
                                        @item.Quantity
                                    </td>

                                    <td>
                                        @item.UnitWeightGram g
                                    </td>

                                    <td>
                                        @item.TotalWeightKg.ToString(
                                            "0.00") kg
                                    </td>

                                    <td class="text-muted">
                                        @(string.IsNullOrWhiteSpace(
                                            item.Notes)
                                            ? "—"
                                            : item.Notes)
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        </div>

    </div>
</body>
</html>