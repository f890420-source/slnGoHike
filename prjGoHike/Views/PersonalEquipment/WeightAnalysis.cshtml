@model prjGoHike.ViewModels.CEquipmentWeightAnalysisViewModel

@{
    Layout = null;
    ViewData["Title"] = "裝備重量分析";
}

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
</head>

<body class="bg-light">

    <div class="container py-5">

        <div class="mb-4">
            <div class="text-success">STEP 04</div>

            <h2>裝備重量分析</h2>

            <p class="text-muted">
                比較目前裝備重量與個人安全負重上限。
            </p>
        </div>

        <div class="alert alert-info">
            <strong>@Model.Condition.ListName</strong>
            ／ @Model.MountainName
            ／ @Model.Condition.HikingDays 天
            ／ @Model.Condition.Season
            ／ @Model.Condition.IntensityLevel
            ／ @Model.Condition.ExperienceLevel
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="row g-4 mb-4">

            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted mb-2">
                            目前裝備總重量
                        </div>

                        <div class="display-6 fw-bold">
                            @Model.TotalWeightKg.ToString("0.00") kg
                        </div>

                        <div class="small text-muted mt-2">
                            共 @Model.Items.Count 件裝備項目
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted mb-2">
                            安全負重上限
                        </div>

                        <div class="display-6 fw-bold">
                            @Model.MaxCarryWeightKg.ToString("0.00") kg
                        </div>

                        <div class="small text-muted mt-2">
                            體重 @Model.Condition.BodyWeightKg.ToString("0.00") kg × 20%
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm h-100 border-@Model.StatusBootstrapClass">
                    <div class="card-body">
                        <div class="text-muted mb-2">
                            負重狀態
                        </div>

                        <div class="display-6 fw-bold text-@Model.StatusBootstrapClass">
                            @Model.WeightStatus
                        </div>

                        <div class="small text-muted mt-2">
                            占體重 @Model.BodyWeightPercentage.ToString("0.00")%
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <div class="d-flex justify-content-between mb-2">
                    <span>安全負重上限使用比例</span>
                    <strong>
                        @Model.LoadLimitUsagePercentage.ToString("0.00")%
                    </strong>
                </div>

                <div class="progress"
                     style="height: 24px;">
                    <div class="progress-bar bg-@Model.StatusBootstrapClass"
                         role="progressbar"
                         style="width: @Model.ProgressPercentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"
                         aria-valuenow="@Model.ProgressPercentage"
                         aria-valuemin="0"
                         aria-valuemax="100">
                    </div>
                </div>

                @if (Model.IsOverweight)
                {
                    <div class="alert alert-danger mt-3 mb-0">
                        目前超過安全負重上限
                        <strong>
                            @Model.OverweightKg.ToString("0.00") kg
                        </strong>
                        ，建議回到清單減少裝備或重量。
                    </div>
                }
                else
                {
                    <div class="alert alert-success mt-3 mb-0">
                        距離安全負重上限還可增加
                        <strong>
                            @Model.RemainingWeightKg.ToString("0.00") kg
                        </strong>
                        。
                    </div>
                }

            </div>
        </div>

        <div class="row g-4">

            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title mb-3">
                            分類重量占比
                        </h5>

                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>分類</th>
                                        <th>項目數</th>
                                        <th>重量</th>
                                        <th>占比</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var category
                                        in Model.CategoryWeights)
                                    {
                                        <tr>
                                            <td>@category.CategoryName</td>
                                            <td>@category.ItemCount</td>
                                            <td>
                                                @category.TotalWeightKg.ToString("0.00") kg
                                            </td>
                                            <td>
                                                @category.WeightPercentage.ToString("0.00")%
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title mb-3">
                            裝備重量明細
                        </h5>

                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>裝備</th>
                                        <th>數量</th>
                                        <th>小計</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>@item.EquipmentName</td>
                                            <td>@item.Quantity</td>
                                            <td>
                                                @((item.TotalWeightGram / 1000M).ToString("0.00")) kg
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="EditItems"
               class="btn btn-outline-secondary">
                上一步：調整清單
            </a>

            <form asp-action="SaveList"
                  method="post"
                  class="m-0">

                <button type="submit"
                        class="btn btn-success">
                    下一步：儲存清單
                </button>

            </form>
        </div>

    </div>

</body>
</html>
