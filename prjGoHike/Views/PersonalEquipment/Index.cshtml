@model prjGoHike.ViewModels.CPersonalEquipmentListIndexViewModel

@{
    Layout = null;
    ViewData["Title"] = "裝備清單記錄";
}

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
            body {
                background-color: #f4f7f5;
            }

            .page-container {
                max-width: 1200px;
            }

            .step-label {
                color: #198754;
                font-size: 0.85rem;
                font-weight: 600;
            }

            .list-card {
                border: 0;
                border-radius: 14px;
            }

            .status-badge {
                min-width: 96px;
                display: inline-block;
                padding: 0.45rem 0.75rem;
                border-radius: 999px;
                text-align: center;
            }

            .empty-area {
                padding: 4rem 1rem;
                text-align: center;
                color: #6c757d;
            }

            .table > :not(caption) > * > * {
                padding: 1rem 0.75rem;
                vertical-align: middle;
            }
    </style>
</head>

<body>
    <div class="container page-container py-5">

        <div class="mb-4">
            <div class="step-label">
                STEP 05
            </div>

            <h2 class="mb-2">
                裝備清單記錄
            </h2>

            <p class="text-muted mb-0">
                查看已儲存的個人裝備清單與負重狀態。
            </p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="card list-card shadow-sm mb-4">
            <div class="card-body p-4">

                <form asp-action="Index"
                      method="get">

                    <div class="row g-3 align-items-end">

                        <div class="col-lg-6">
                            <label for="searchKeyword"
                                   class="form-label">
                                搜尋清單
                            </label>

                            <input type="text"
                                   id="searchKeyword"
                                   name="searchKeyword"
                                   value="@Model.SearchKeyword"
                                   class="form-control"
                                   placeholder="輸入清單名稱或山岳名稱" />
                        </div>

                        <div class="col-lg-3">
                            <label for="statusFilter"
                                   class="form-label">
                                負重狀態
                            </label>

                            <select id="statusFilter"
                                    name="statusFilter"
                                    class="form-select">

                                <option value="">
                                    全部狀態
                                </option>

                                <option value="安全範圍"
                                        selected="@(Model.StatusFilter == "安全範圍")">
                                    安全範圍
                                </option>

                                <option value="接近安全上限"
                                        selected="@(Model.StatusFilter == "接近安全上限")">
                                    接近安全上限
                                </option>

                                <option value="超過安全上限"
                                        selected="@(Model.StatusFilter == "超過安全上限")">
                                    超過安全上限
                                </option>
                            </select>
                        </div>

                        <div class="col-lg-3">
                            <div class="d-grid gap-2 d-md-flex">

                                <button type="submit"
                                        class="btn btn-success flex-fill">
                                    搜尋
                                </button>

                                <a asp-action="Index"
                                   class="btn btn-outline-secondary flex-fill">
                                    清除
                                </a>
                            </div>
                        </div>

                    </div>
                </form>

                <div class="d-flex justify-content-between
                    align-items-center mt-4">

                    <div class="text-muted">
                        共 @Model.Items.Count 筆清單
                    </div>

                    <a asp-action="Create"
                       class="btn btn-success">
                        ＋ 新增清單
                    </a>
                </div>

            </div>
        </div>

        <div class="card list-card shadow-sm">
            <div class="card-body p-0">

                @if (Model.Items.Count == 0)
                {
                    <div class="empty-area">
                        <h5>目前沒有符合條件的清單</h5>

                        <p class="mb-3">
                            建立第一份個人裝備清單，
                            即可在這裡查看記錄。
                        </p>

                        <a asp-action="Create"
                           class="btn btn-success">
                            新增裝備清單
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th>清單名稱</th>
                                    <th>山岳</th>
                                    <th>登山日期</th>
                                    <th>天數</th>
                                    <th>總重量</th>
                                    <th>負重狀態</th>
                                    <th>建立時間</th>
                                    <th>詳細內容</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item
                                    in Model.Items)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            @item.ListName
                                        </td>

                                        <td>
                                            @item.MountainName
                                        </td>

                                        <td>
                                            @item.HikingDate.ToString(
                                                "yyyy/MM/dd")
                                        </td>

                                        <td>
                                            @item.HikingDays 天
                                        </td>

                                        <td>
                                            @item.TotalWeightKg.ToString(
                                                "0.00") kg
                                        </td>

                                        <td>
                                            <span class="
                                                status-badge
                                                text-bg-@item.StatusBootstrapClass">
                                                @item.WeightStatus
                                            </span>
                                        </td>

                                        <td>
                                            @item.CreatedAt.ToString(
                                                "yyyy/MM/dd HH:mm")
                                        </td>

                                        <td>
                                            <div class="d-flex gap-2">

                                                <a asp-action="Details"
                                                   asp-route-id="@item.ListId"
                                                   class="btn btn-sm btn-outline-success">
                                                    查看
                                                </a>

                                                <a asp-action="Edit"
                                                   asp-route-id="@item.ListId"
                                                   class="btn btn-sm btn-outline-primary">
                                                    編輯
                                                </a>

                                                <form asp-action="Delete"
                                                      asp-route-id="@item.ListId"
                                                      method="post"
                                                      class="m-0"
                                                      onsubmit="return confirm('確定要刪除這份裝備清單嗎？');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger">
                                                        刪除
                                                    </button>
                                                </form>

                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>
                }

            </div>
        </div>

    </div>
</body>
</html>