{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Hangfire": {
    "Enabled": false,
    "PrepareSchemaIfNecessary": false,
    "CommandTimeoutSeconds": 30,
    "SyncCommandTimeoutSeconds": 300,
    "LockTimeoutMilliseconds": 5000
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "GoHikeDataContext": "Data Source=.;Initial Catalog=GoHikeData;Integrated Security=True;Trust Server Certificate=True"
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "GoHikeApi",
    "Audience": "GoHikeClient",
    "AccessTokenExpiryMinutes": 30,
    "RefreshTokenExpiryDays": 7
  },
  "GoogleAuth": {
    "ClientId": ""
  }
}
